  "texts": {
    "1": {
      "name": "Al-Fatiha",
      "ayahs": [
        { "n": 1, "ar": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ", "ur": "اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے" },
        { "n": 2, "ar": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "ur": "تمام تعریفیں اللہ کے لیے ہیں جو تمام جہانوں کا پالنے والا ہے" },
        { "n": 3, "ar": "الرَّحْمَٰنِ الرَّحِيمِ", "ur": "جو بڑا مہربان، نہایت رحم والا ہے" },
        { "n": 4, "ar": "مَالِكِ يَوْمِ الدِّينِ", "ur": "روزِ جزا کا مالک ہے" },
        { "n": 5, "ar": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ", "ur": "ہم تیری ہی عبادت کرتے ہیں اور تجھ ہی سے مدد مانگتے ہیں" },
        { "n": 6, "ar": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ", "ur": "ہمیں سیدھا راستہ دکھا" },
        { "n": 7, "ar": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ", "ur": "ان لوگوں کا راستہ جن پر تو نے انعام کیا، نہ کہ ان کا جن پر غضب ہوا اور نہ گمراہوں کا" }
      ]
    },
    "112": {
      "name": "Al-Ikhlas",
      "ayahs": [
        { "n": 1, "ar": "قُلْ هُوَ اللَّهُ أَحَدٌ", "ur": "کہہ دو، وہ اللہ ایک ہے" },
        { "n": 2, "ar": "اللَّهُ الصَّمَدُ", "ur": "اللہ بے نیاز ہے" },
        { "n": 3, "ar": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "ur": "نہ اس نے کسی کو جنا اور نہ وہ جنا گیا" },
        { "n": 4, "ar": "وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ", "ur": "اور کوئی اس کا ہمسر نہیں" }
      ]
    },
    "113": {
      "name": "Al-Falaq",
      "ayahs": [
        { "n": 1, "ar": "قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ", "ur": "کہہ دو، میں پناہ مانگتا ہوں صبح کے رب کی" },
        { "n": 2, "ar": "مِنْ شَرِّ مَا خَلَقَ", "ur": "ہر اس چیز کے شر سے جو اس نے پیدا کی" },
        { "n": 3, "ar": "وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ", "ur": "اور اندھیری رات کے شر سے جب اس کا اندھیرا پھیل جائے" },
        { "n": 4, "ar": "وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ", "ur": "اور گرہوں میں پھونک مارنے والیوں کے شر سے" },
        { "n": 5, "ar": "وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ", "ur": "اور حسد کرنے والے کے شر سے جب وہ حسد کرے" }
      ]
    },
    "114": {
      "name": "An-Nas",
      "ayahs": [
        { "n": 1, "ar": "قُلْ أَعُوذُ بِرَبِّ النَّاسِ", "ur": "کہہ دو، میں پناہ مانگتا ہوں لوگوں کے رب کی" },
        { "n": 2, "ar": "مَلِكِ النَّاسِ", "ur": "لوگوں کے بادشاہ کی" },
        { "n": 3, "ar": "إِلَٰهِ النَّاسِ", "ur": "لوگوں کے معبود کی" },
        { "n": 4, "ar": "مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ", "ur": "وسوسہ ڈالنے والے، پیچھے ہٹ جانے والے کے شر سے" },
        { "n": 5, "ar": "الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ", "ur": "جو لوگوں کے سینوں میں وسوسہ ڈالتا ہے" },
        { "n": 6, "ar": "مِنَ الْجِنَّةِ وَالنَّاسِ", "ur": "خواہ وہ جنوں میں سے ہو یا انسانوں میں سے" }
      ]
    },
    "109": {
      "name": "Al-Kafirun",
      "ayahs": [
        { "n": 1, "ar": "قُلْ يَا أَيُّهَا الْكَافِرُونَ", "ur": "کہہ دو، اے کافرو!" },
        { "n": 2, "ar": "لَا أَعْبُدُ مَا تَعْبُدُونَ", "ur": "میں ان کی عبادت نہیں کرتا جن کی تم عبادت کرتے ہو" },
        { "n": 3, "ar": "وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ", "ur": "اور نہ تم اس کی عبادت کرنے والے ہو جس کی میں عبادت کرتا ہوں" },
        { "n": 4, "ar": "وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ", "ur": "اور نہ میں اس کی عبادت کرنے والا ہوں جس کی تم نے عبادت کی" },
        { "n": 5, "ar": "وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ", "ur": "اور نہ تم اس کی عبادت کرنے والے ہو جس کی میں عبادت کرتا ہوں" },
        { "n": 6, "ar": "لَكُمْ دِينُكُمْ وَلِيَ دِينِ", "ur": "تمہارے لیے تمہارا دین ہے اور میرے لیے میرا دین" }
      ]
    },
    "103": {
      "name": "Al-Asr",
      "ayahs": [
        { "n": 1, "ar": "وَالْعَصْرِ", "ur": "زمانے کی قسم" },
        { "n": 2, "ar": "إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ", "ur": "بے شک انسان نقصان میں ہے" },
        { "n": 3, "ar": "إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ", "ur": "سوائے ان کے جو ایمان لائے اور نیک عمل کیے اور ایک دوسرے کو حق کی نصیحت کی اور صبر کی نصیحت کی" }
      ]
    },
    "97": {
      "name": "Al-Qadr",
      "ayahs": [
